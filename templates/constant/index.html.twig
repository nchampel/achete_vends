{% extends 'base.html.twig' %}

{% block title %}Constant index{% endblock %}

{% block body %}
    <h1>Constant index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Value</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for constant in constants %}
            <tr>
                <td>{{ constant.id }}</td>
                <td>{{ constant.name }}</td>
                <td>{{ constant.value }}</td>
                <td>
                    <a href="{{ path('app_constant_show', {'id': constant.id}) }}">show</a>
                    <a href="{{ path('app_constant_edit', {'id': constant.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_constant_new') }}">Create new</a>
{% endblock %}
