<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link href="https://fr.getfonts.net/allfont.css?fonts=cinzel-black" rel="stylesheet" type="text/css" />
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">
        {# Run `composer require symfony/webpack-encore-bundle` to start using Symfony UX #}
        {% block stylesheets %}
        <style>
      body > .container {
        font-family: 'Cinzel Black', arial;
        font-size: 24px;
        text-shadow: 2px 2px 2px #f6e79a;
        /* color: #f99f72; */
        color: #30251F;
      }
    </style>
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body>
        <div class="container">
            
        {% block body %}{% endblock %}
        </div>
    </body>
</html>
