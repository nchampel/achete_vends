{% extends 'base.html.twig' %}

{% block title %}StockItem index{% endblock %}

{% block body %}
    <h1>StockItem index</h1>

    {# {% include 'utils/playerData.html.twig' %} #}

    <h3>Articles en stock non vendus</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Joueur</th>
                <th>Name</th>
                <th>FinalPayPrice</th>
                <th>FinalSellPrice</th>
                <th>UserSellPrice</th>
                <th>IsBought</th>
                <th>IsSold</th>
                <th>IsBuyable</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for stock_item in stock_items_users_not_sold %}
            <tr>
                <td>{{ stock_item.id }}</td>
                <td>{{ stock_item.user.pseudo }}</td>
                <td>{{ stock_item.item.name }}</td>
                <td>{{ stock_item.finalPayPrice }}</td>
                <td>{{ stock_item.finalSellPrice }}</td>
                <td>{{ stock_item.userSellPrice }}</td>
                <td>{{ stock_item.isBought ? 'Yes' : 'No' }}</td>
                <td>{{ stock_item.isSold ? 'Yes' : 'No' }}</td>
                <td>{{ stock_item.isBuyable ? 'Yes' : 'No' }}</td>
                <td>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_stock_item_show', {'id': stock_item.id}) }}">show</a>
                        <a href="{{ path('app_stock_item_edit', {'id': stock_item.id}) }}">edit</a>
                    {% endif %}
                    <a href="{{ path('app_stock_item_price_edit', {'id': stock_item.id}) }}">Vendre</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <h3>Articles en stock vendus</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Joueur</th>
                <th>Name</th>
                <th>FinalPayPrice</th>
                <th>FinalSellPrice</th>
                <th>UserSellPrice</th>
                <th>IsBought</th>
                <th>IsSold</th>
                <th>IsBuyable</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for stock_item in stock_items_users_sold %}
            <tr>
                <td>{{ stock_item.id }}</td>
                <td>{{ stock_item.user.pseudo }}</td>
                <td>{{ stock_item.item.name }}</td>
                <td>{{ stock_item.finalPayPrice }}</td>
                <td>{{ stock_item.finalSellPrice }}</td>
                <td>{{ stock_item.userSellPrice }}</td>
                <td>{{ stock_item.isBought ? 'Yes' : 'No' }}</td>
                <td>{{ stock_item.isSold ? 'Yes' : 'No' }}</td>
                <td>{{ stock_item.isBuyable ? 'Yes' : 'No' }}</td>
                <td>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_stock_item_show', {'id': stock_item.id}) }}">show</a>
                        <a href="{{ path('app_stock_item_edit', {'id': stock_item.id}) }}">edit</a>
                    {% endif %}
                    <a href="{{ path('app_stock_item_price_edit', {'id': stock_item.id}) }}">Vendre</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <h3>Articles en stock</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>FinalPayPrice</th>
                <th>FinalSellPrice</th>
                <th>IsBought</th>
                <th>IsSold</th>
                <th>IsBuyable</th>
                {% if is_granted('ROLE_ADMIN') %}
                    <th>actions</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
        {% for stock_item in stock_items_stock %}
            <tr>
                <td>{{ stock_item.id }}</td>
                <td>{{ stock_item.item.name }}</td>
                <td>{{ stock_item.finalPayPrice }}</td>
                <td>{{ stock_item.finalSellPrice }}</td>
                <td>{{ stock_item.isBought ? 'Yes' : 'No' }}</td>
                <td>{{ stock_item.isSold ? 'Yes' : 'No' }}</td>
                <td>{{ stock_item.isBuyable ? 'Yes' : 'No' }}</td>
                {% if is_granted('ROLE_ADMIN') %}
                    <td>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_stock_item_show', {'id': stock_item.id}) }}">show</a>
                            <a href="{{ path('app_stock_item_edit', {'id': stock_item.id}) }}">edit</a>
                        {% endif %}
                        <a href="{{ path('app_stock_item_price_edit', {'id': stock_item.id}) }}">Acheter</a>
                    </td>
                {% endif %}
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_stock_item_sold') }}">Liste des articles vendus</a>

    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_stock_item_new') }}">Create new</a>
    {% endif %}
    <a href="{{ path('app_home') }}">Accueil</a>
{% endblock %}
