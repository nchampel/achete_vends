{% extends 'base.html.twig' %}

{% block title %}World index{% endblock %}

{% block body %}
    <h1>World index</h1>

    {# {% include 'utils/playerData.html.twig' %} #}

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Joueur</th>
                <th>IsUnlocked</th>
                <th>Name</th>
                <th>Amount</th>
                {% if is_granted('ROLE_ADMIN') %}
                    <th>actions</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
        {% for world in worlds %}
            <tr>
                <td>{{ world.id }}</td>
                <td>{{ world.user.pseudo }}</td>
                <td>{{ world.isUnlocked ? 'Yes' : 'No' }}</td>
                <td>{{ world.worldData.name }}</td>
                <td>{{ world.worldData.amount }} €</td>
                {% if is_granted('ROLE_ADMIN') %}
                    <td>
                        <a href="{{ path('app_world_show', {'id': world.id}) }}">show</a>
                        <a href="{{ path('app_world_edit', {'id': world.id}) }}">edit</a>
                    </td>
                {% endif %}
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_world_new') }}">Create new</a>
    {% endif %}
    {% if is_granted('ROLE_USER') %}
        <a href="{{ path('app_world_unlock') }}">Débloquer monde suivant</a>
    {% endif %}
    <a href="{{ path('app_home') }}">Accueil</a>
{% endblock %}
