{% extends 'base.html.twig' %}

{% block title %}StockItem index{% endblock %}

{% block body %}
    <h1>StockItem index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>FinalPayPrice</th>
                <th>FinalSellPrice</th>
                <th>IsBought</th>
                <th>IsSold</th>
                <th>IsBuyable</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for stock_item in stock_items %}
            <tr>
                <td>{{ stock_item.id }}</td>
                <td>{{ stock_item.item.name }}</td>
                <td>{{ stock_item.finalPayPrice }}</td>
                <td>{{ stock_item.finalSellPrice }}</td>
                <td>{{ stock_item.isBought ? 'Yes' : 'No' }}</td>
                <td>{{ stock_item.isSold ? 'Yes' : 'No' }}</td>
                <td>{{ stock_item.isBuyable ? 'Yes' : 'No' }}</td>
                <td>
                    <a href="{{ path('app_stock_item_show', {'id': stock_item.id}) }}">show</a>
                    <a href="{{ path('app_stock_item_edit', {'id': stock_item.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_stock_item_new') }}">Create new</a>
{% endblock %}
