{% extends 'base.html.twig' %}

{% block title %}StockItem{% endblock %}

{% block body %}
    <h1>StockItem</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ stock_item.id }}</td>
            </tr>
            <tr>
                <th>FinalPayPrice</th>
                <td>{{ stock_item.finalPayPrice }}</td>
            </tr>
            <tr>
                <th>FinalSellPrice</th>
                <td>{{ stock_item.finalSellPrice }}</td>
            </tr>
            <tr>
                <th>IsBought</th>
                <td>{{ stock_item.isBought ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>IsSold</th>
                <td>{{ stock_item.isSold ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>IsBuyable</th>
                <td>{{ stock_item.isBuyable ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_stock_item_index') }}">back to list</a>

    <a href="{{ path('app_stock_item_edit', {'id': stock_item.id}) }}">edit</a>

    {{ include('stock_item/_delete_form.html.twig') }}
{% endblock %}
