{% extends 'base.html.twig' %}

{% block title %}Achète et vends{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Bonjour {{ user.pseudo }}!</h1>

    <h2>Argent : {{user.money }} €</h2>

    <h2>Monde {{ user.currentWorld.worldData.name }}</h2>

    <a href="{{ path('app_stock_item_index') }}">Marchand</a>

    {% if is_granted('ROLE_ADMIN') %}

        <a href="{{ path('app_user_index') }}">utilisateur</a>
        <a href="{{ path('app_world_players_index') }}">monde</a>
        <a href="{{ path('app_world_data_index_admin') }}">données monde</a>
        <a href="{{ path('app_item_index') }}">article</a>
        <a href="{{ path('app_constant_index') }}">constante</a>
        <a href="{{ path('app_stock_item_all_index') }}">article en stock et de joueurs</a>
    {% endif %}
</div>
{% endblock %}
